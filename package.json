{
  "name": "privpass",
  "private": true,
  "version": "0.1.0",
  "description": "PrivPass — privacy-preserving identity verification on Midnight/Compact. Verify identity. Reveal nothing unnecessary.",
  "workspaces": [
    "backend",
    "frontend",
    "contracts"
  ],
  "packageManager": "yarn@4.1.1",
  "scripts": {
    "dev:backend": "yarn workspace @privpass/backend dev",
    "dev:frontend": "yarn workspace @privpass/frontend dev",
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "compact:compile": "yarn workspace @privpass/contracts compile",
    "db:migrate": "yarn workspace @privpass/backend db:migrate",
    "db:seed": "yarn workspace @privpass/backend db:seed"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
