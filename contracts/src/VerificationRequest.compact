// VerificationRequest.compact
//
// Manages zero-knowledge verification requests, lifecycle state transitions,
// cryptographic TTL timeouts, and selective disclosure claim evaluation.
//
// Invariant: No raw PII is ever stored on-chain. Only request metadata,
// requested claim masks, nullifiers, and boolean claim outcomes are recorded.

pragma language_version >= 0.16;

import CompactStandardLibrary;

export enum ClaimType {
  PAN_VALID,
  AADHAAR_VERIFIED,
  AGE_OVER_18,
  IDENTITY_VERIFIED,
  RESIDENCY_VALID
}

export enum RequestStatus {
  PENDING,
  APPROVED,
  REJECTED,
  COMPLETED,
  EXPIRED,
  CANCELLED
}

witness requesterSecret(): Bytes<32>;
witness requesterSalt(): Bytes<32>;
witness userSecret(): Bytes<32>;
witness dobUnixSeconds(): Uint<64>;
witness commitmentSalt(): Bytes<32>;
witness panRaw(): Bytes<16>;
witness aadhaarRaw(): Bytes<16>;
witness addressRaw(): Bytes<128>;

export struct RequestRecord {
  requester: Bytes<32>;
  panRequested: Boolean;
  aadhaarRequested: Boolean;
  ageRequested: Boolean;
  residencyRequested: Boolean;
  identityRequested: Boolean;
  createdAt: Uint<64>;
  expiresAt: Uint<64>;
  status: RequestStatus;
}

export struct ClaimResults {
  panRequested: Boolean;
  panValid: Boolean;
  aadhaarRequested: Boolean;
  aadhaarVerified: Boolean;
  ageRequested: Boolean;
  ageOver18: Boolean;
  residencyRequested: Boolean;
  residencyValid: Boolean;
  identityRequested: Boolean;
  identityVerified: Boolean;
  nullifier: Bytes<32>;
}

export ledger requests: Map<Bytes<32>, RequestRecord>;
export ledger results: Map<Bytes<32>, ClaimResults>;
export ledger processedNullifiers: Map<Bytes<32>, Boolean>;

// -------------------------------------------------------------------
// Internal Circuit Verifiers
// -------------------------------------------------------------------

circuit isUpperAlpha(c: Uint<8>): Boolean {
  return c >= 65 && c <= 90;
}

circuit isDigit(c: Uint<8>): Boolean {
  return c >= 48 && c <= 57;
}

circuit proveAgeOver18Internal(credentialCommitment: Bytes<32>, nowUnixSeconds: Uint<64>): Boolean {
  const dob = dobUnixSeconds();
  const salt = commitmentSalt();
  const recomputed = persistentHash<[Uint<64>, Bytes<32>]>([dob, salt]);
  assert(recomputed == credentialCommitment, "commitment mismatch");
  assert(nowUnixSeconds >= dob, "invalid dob");
  const age = nowUnixSeconds - dob;
  return age >= 568025136; // 18 years in seconds
}

circuit provePanValidInternal(credentialCommitment: Bytes<32>): Boolean {
  const pan = panRaw();
  const salt = commitmentSalt();
  const recomputed = persistentHash<[Bytes<16>, Bytes<32>]>([pan, salt]);
  assert(recomputed == credentialCommitment, "commitment mismatch");

  // Validate full 10-char format [A-Z]{5}[0-9]{4}[A-Z]{1}
  return isUpperAlpha(pan[0]) && isUpperAlpha(pan[1]) && isUpperAlpha(pan[2]) &&
         isUpperAlpha(pan[3]) && isUpperAlpha(pan[4]) && isDigit(pan[5]) &&
         isDigit(pan[6]) && isDigit(pan[7]) && isDigit(pan[8]) && isUpperAlpha(pan[9]);
}

circuit proveAadhaarVerifiedInternal(credentialCommitment: Bytes<32>): Boolean {
  const aadhaar = aadhaarRaw();
  const salt = commitmentSalt();
  const recomputed = persistentHash<[Bytes<16>, Bytes<32>]>([aadhaar, salt]);
  assert(recomputed == credentialCommitment, "commitment mismatch");

  // Validate all 12 digits
  return isDigit(aadhaar[0]) && isDigit(aadhaar[1]) && isDigit(aadhaar[2]) &&
         isDigit(aadhaar[3]) && isDigit(aadhaar[4]) && isDigit(aadhaar[5]) &&
         isDigit(aadhaar[6]) && isDigit(aadhaar[7]) && isDigit(aadhaar[8]) &&
         isDigit(aadhaar[9]) && isDigit(aadhaar[10]) && isDigit(aadhaar[11]);
}

circuit proveResidencyValidInternal(credentialCommitment: Bytes<32>): Boolean {
  const address = addressRaw();
  const salt = commitmentSalt();
  const recomputed = persistentHash<[Bytes<128>, Bytes<32>]>([address, salt]);
  assert(recomputed == credentialCommitment, "commitment mismatch");
  return true;
}

circuit proveIdentityVerifiedInternal(panCommitment: Bytes<32>, aadhaarCommitment: Bytes<32>): Boolean {
  return provePanValidInternal(panCommitment) && proveAadhaarVerifiedInternal(aadhaarCommitment);
}

// -------------------------------------------------------------------
// Request Lifecycle Circuits
// -------------------------------------------------------------------

export circuit createRequest(
  requestId: Bytes<32>,
  requester: Bytes<32>,
  panRequested: Boolean,
  aadhaarRequested: Boolean,
  ageRequested: Boolean,
  residencyRequested: Boolean,
  identityRequested: Boolean,
  createdAt: Uint<64>,
  expiresAt: Uint<64>
): [] {
  const discRequestId = disclose(requestId);
  assert(!requests.member(discRequestId), "request already exists");
  assert(
    panRequested || aadhaarRequested || ageRequested || residencyRequested || identityRequested,
    "at least one claim must be requested"
  );
  assert(expiresAt > createdAt, "expiry must be after creation");

  const record: RequestRecord = RequestRecord {
    requester: disclose(requester),
    panRequested: disclose(panRequested),
    aadhaarRequested: disclose(aadhaarRequested),
    ageRequested: disclose(ageRequested),
    residencyRequested: disclose(residencyRequested),
    identityRequested: disclose(identityRequested),
    createdAt: disclose(createdAt),
    expiresAt: disclose(expiresAt),
    status: RequestStatus.PENDING
  };

  requests.insert(discRequestId, record);
}

export circuit cancelRequest(requestId: Bytes<32>): [] {
  const discRequestId = disclose(requestId);
  assert(requests.member(discRequestId), "unknown request");
  const record = requests.lookup(discRequestId);
  assert(record.status == RequestStatus.PENDING, "cannot cancel in current status");

  const secret = requesterSecret();
  const salt = requesterSalt();
  const recomputed = persistentHash<[Bytes<32>, Bytes<32>]>([secret, salt]);
  assert(recomputed == record.requester, "only the requesting organization may cancel");

  requests.insert(discRequestId, RequestRecord {
    requester: record.requester,
    panRequested: record.panRequested,
    aadhaarRequested: record.aadhaarRequested,
    ageRequested: record.ageRequested,
    residencyRequested: record.residencyRequested,
    identityRequested: record.identityRequested,
    createdAt: record.createdAt,
    expiresAt: record.expiresAt,
    status: RequestStatus.CANCELLED
  });
}

export circuit completeRequest(
  requestId: Bytes<32>,
  nowUnixSeconds: Uint<64>,
  panCommitment: Bytes<32>,
  aadhaarCommitment: Bytes<32>,
  ageCommitment: Bytes<32>,
  residencyCommitment: Bytes<32>,
  identityPanCommitment: Bytes<32>,
  identityAadhaarCommitment: Bytes<32>
): [] {
  const discRequestId = disclose(requestId);
  assert(requests.member(discRequestId), "unknown request");
  const record = requests.lookup(discRequestId);
  assert(record.status == RequestStatus.PENDING, "request not pending");
  assert(disclose(nowUnixSeconds) < record.expiresAt, "request expired");

  // Generate and assert nullifier to prevent double submission
  const userSec = userSecret();
  const nullifier = persistentHash<[Bytes<32>, Bytes<32>]>([userSec, requestId]);
  const discNullifier = disclose(nullifier);
  assert(!processedNullifiers.member(discNullifier), "nullifier already used for this request");
  processedNullifiers.insert(discNullifier, true);

  const panOk = !record.panRequested || provePanValidInternal(panCommitment);
  const aadhaarOk = !record.aadhaarRequested || proveAadhaarVerifiedInternal(aadhaarCommitment);
  const ageOk = !record.ageRequested || proveAgeOver18Internal(ageCommitment, nowUnixSeconds);
  const residencyOk = !record.residencyRequested || proveResidencyValidInternal(residencyCommitment);
  const identityOk = !record.identityRequested || proveIdentityVerifiedInternal(identityPanCommitment, identityAadhaarCommitment);

  const claimResults: ClaimResults = ClaimResults {
    panRequested: record.panRequested,
    panValid: disclose(record.panRequested && panOk),
    aadhaarRequested: record.aadhaarRequested,
    aadhaarVerified: disclose(record.aadhaarRequested && aadhaarOk),
    ageRequested: record.ageRequested,
    ageOver18: disclose(record.ageRequested && ageOk),
    residencyRequested: record.residencyRequested,
    residencyValid: disclose(record.residencyRequested && residencyOk),
    identityRequested: record.identityRequested,
    identityVerified: disclose(record.identityRequested && identityOk),
    nullifier: discNullifier
  };

  results.insert(discRequestId, claimResults);

  requests.insert(discRequestId, RequestRecord {
    requester: record.requester,
    panRequested: record.panRequested,
    aadhaarRequested: record.aadhaarRequested,
    ageRequested: record.ageRequested,
    residencyRequested: record.residencyRequested,
    identityRequested: record.identityRequested,
    createdAt: record.createdAt,
    expiresAt: record.expiresAt,
    status: RequestStatus.COMPLETED
  });
}

export circuit expireIfDue(requestId: Bytes<32>, nowUnixSeconds: Uint<64>): RequestStatus {
  const discRequestId = disclose(requestId);
  assert(requests.member(discRequestId), "unknown request");
  const record = requests.lookup(discRequestId);
  const discNow = disclose(nowUnixSeconds);

  if (record.status == RequestStatus.PENDING && discNow >= record.expiresAt) {
    requests.insert(discRequestId, RequestRecord {
      requester: record.requester,
      panRequested: record.panRequested,
      aadhaarRequested: record.aadhaarRequested,
      ageRequested: record.ageRequested,
      residencyRequested: record.residencyRequested,
      identityRequested: record.identityRequested,
      createdAt: record.createdAt,
      expiresAt: record.expiresAt,
      status: RequestStatus.EXPIRED
    });
    return RequestStatus.EXPIRED;
  }

  return record.status;
}
