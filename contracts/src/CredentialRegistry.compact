pragma language_version >= 0.16;

import CompactStandardLibrary;

witness issuerSecret(): Bytes<32>;
witness issuerSalt(): Bytes<32>;

circuit authorityId(secret: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>([secret, salt]);
}

export ledger authorizedIssuers: Map<Bytes<32>, Boolean>;

export circuit authorizeIssuer(issuerIdentity: Bytes<32>): [] {
  authorizedIssuers.insert(disclose(issuerIdentity), true);
}

export enum CredentialType {
  PAN,
  AADHAAR,
  AGE,
  RESIDENCY,
  IDENTITY_COMPOSITE
}

export enum CredentialStatus {
  ISSUED,
  ACTIVE,
  EXPIRED,
  REVOKED
}

export struct CredentialRecord {
  commitment: Bytes<32>;
  credentialType: CredentialType;
  issuer: Bytes<32>;
  issuedAt: Uint<64>;
  expiresAt: Uint<64>;
  status: CredentialStatus;
}

export ledger credentials: Map<Bytes<32>, CredentialRecord>;

export circuit registerCredential(
  commitment: Bytes<32>,
  credentialType: CredentialType,
  issuer: Bytes<32>,
  issuedAt: Uint<64>,
  expiresAt: Uint<64>
): [] {
  const discCommitment = disclose(commitment);
  const discIssuer = disclose(issuer);
  assert(!credentials.member(discCommitment), "credential already registered");
  assert(expiresAt > issuedAt, "expiry must be after issuance");

  const callerIssuerId = authorityId(issuerSecret(), issuerSalt());
  assert(callerIssuerId == issuer, "caller is not the stated issuer");
  assert(
    authorizedIssuers.member(discIssuer) && authorizedIssuers.lookup(discIssuer),
    "issuer not authorized"
  );

  const record: CredentialRecord = CredentialRecord {
    commitment: discCommitment,
    credentialType: disclose(credentialType),
    issuer: discIssuer,
    issuedAt: disclose(issuedAt),
    expiresAt: disclose(expiresAt),
    status: CredentialStatus.ACTIVE
  };

  credentials.insert(discCommitment, record);
}

export circuit revokeCredential(commitment: Bytes<32>): [] {
  const discCommitment = disclose(commitment);
  assert(credentials.member(discCommitment), "unknown credential");
  const record = credentials.lookup(discCommitment);
  assert(record.status != CredentialStatus.REVOKED, "already revoked");

  const callerIssuerId = authorityId(issuerSecret(), issuerSalt());
  assert(callerIssuerId == record.issuer, "only the issuing authority may revoke");

  const updated: CredentialRecord = CredentialRecord {
    commitment: record.commitment,
    credentialType: record.credentialType,
    issuer: record.issuer,
    issuedAt: record.issuedAt,
    expiresAt: record.expiresAt,
    status: CredentialStatus.REVOKED
  };

  credentials.insert(discCommitment, updated);
}

export circuit statusOf(commitment: Bytes<32>, now: Uint<64>): CredentialStatus {
  const discCommitment = disclose(commitment);
  assert(credentials.member(discCommitment), "unknown credential");
  const record = credentials.lookup(discCommitment);
  const discNow = disclose(now);

  if (record.status == CredentialStatus.REVOKED) {
    return CredentialStatus.REVOKED;
  }
  if (discNow >= record.expiresAt) {
    return CredentialStatus.EXPIRED;
  }
  return record.status;
}
