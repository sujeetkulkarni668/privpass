NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://privpass:privpass@localhost:5432/privpass
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
PLATFORM_ADMIN_USER_IDS=
# 32-byte hex key for reversible encryption of webhook signing secrets
# (see backend/src/lib/secretBox.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value; rotating it invalidates existing webhook
# secrets (customers would need to be re-issued new ones).
WEBHOOK_ENCRYPTION_KEY=
# Midnight Preprod (see docs/deployment.md and docs/midnight.md) — leave
# blank until you've compiled contracts and deployed them yourself.
# MIDNIGHT_NETWORK_ID: "undeployed" (local/simulated), "testnet" (Preprod
# is Midnight's public testnet), or "mainnet" once available.
MIDNIGHT_NETWORK_ID=undeployed
MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
# Path or URL the FetchZkConfigProvider/NodeZkConfigProvider reads
# compiled ZK artifacts from (contracts/managed/<Contract>) — see
# docs/midnight.md.
MIDNIGHT_ZK_CONFIG_PATH=../contracts/managed
# Hex-encoded wallet seed for the backend's own signing/paying wallet
# (used to submit registerCredential/revokeCredential/completeRequest
# transactions). NEVER commit a real value; use a funded Preprod test
# wallet in non-prod, and a properly custodied key in production.
MIDNIGHT_WALLET_SEED=
MIDNIGHT_CONTRACT_ADDRESS_CREDENTIAL_REGISTRY=
MIDNIGHT_CONTRACT_ADDRESS_VERIFICATION_REQUEST=
MIDNIGHT_CONTRACT_ADDRESS_REVOCATION_REGISTRY=
# Server-side admin/issuer authorization secrets for CredentialRegistry.compact
# (see contracts/src/CredentialRegistry.compact) — random, high-entropy,
# never reused, never logged. Rotate via CredentialRegistry's
# authorizeIssuer/deauthorizeIssuer circuits if compromised.
MIDNIGHT_ADMIN_SECRET=
MIDNIGHT_ADMIN_SALT=
MIDNIGHT_ISSUER_SECRET=
MIDNIGHT_ISSUER_SALT=
